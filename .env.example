# Copy this file to .env.local and fill in your real connection string.
# Get one free from https://neon.tech or https://supabase.com — takes about 2 minutes.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Change this to a long random string before deploying publicly.
# Anyone with this secret can forge login sessions.
SESSION_SECRET=change-me-to-something-long-and-random
# Browser push notifications for new messages (replaces the old email ping).
# Generate a key pair after "npm install" with:
#   npx web-push generate-vapid-keys
# Then paste the two keys it prints below. NEXT_PUBLIC_VAPID_PUBLIC_KEY is
# safe to expose to the browser (that's what NEXT_PUBLIC_ means) — the
# private key must stay server-only and should never be committed for real.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com
# Long random string that authorizes the scheduled job which deletes
# messages older than 72 hours (see vercel.json + app/api/cron/cleanup-messages).
# Set the same value in Vercel's Environment Variables — Vercel Cron sends
# it automatically as "Authorization: Bearer <this value>" on every trigger.
CRON_SECRET=change-me-to-something-long-and-random